{
  "CIT Hello World": {
    "prefix": "hello",
    "body": [
      "println(\"Hello World!\")"
    ],
    "description": "Print Hello World in CIT"
  },
  "CIT Mutable Variable": {
    "prefix": "letmut",
    "body": [
      "let mut ${1:name} = ${2:value}"
    ],
    "description": "Declare a mutable inferred variable"
  },
  "CIT Typed Variable": {
    "prefix": "typed",
    "body": [
      "${1|int,float,str,char,bool|} ${2:name} = ${3:value}"
    ],
    "description": "Declare a typed variable"
  },
  "CIT If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t${2:println(\"True!\")}",
      "} elseif (${3:other_condition}) {",
      "\t${4:println(\"Else if!\")}",
      "} else {",
      "\t${5:println(\"False!\")}",
      "}"
    ],
    "description": "Insert a CIT if / elseif / else statement"
  },
  "CIT Multi-line Comment": {
    "prefix": "comment",
    "body": [
      "/*",
      "${1:Comment}",
      "*/"
    ],
    "description": "Insert a CIT block comment"
  },
  "CIT For Loop": {
    "prefix": "forrange",
    "body": [
      "for (let ${1:i}, range(${2:0}, ${3:10})) {",
      "\tprintln(${1:i})",
      "}"
    ],
    "description": "Iterate over a numeric range (end is exclusive)"
  },
  "CIT While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t${2:pass}",
      "}"
    ],
    "description": "Repeat while a condition is true"
  },
  "CIT Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:a}, ${3:b = 1}) {",
      "\treturn ${4:a + b}",
      "}"
    ],
    "description": "Declare a function with optional default parameters"
  },
  "CIT Class": {
    "prefix": "class",
    "body": [
      "class ${1:person}() {",
      "\tfn struct(${2:name}, ${3:age}) {",
      "\t\tself.name = ${2:name}",
      "\t\tself.age = ${3:age}",
      "\t}",
      "",
      "\tfn talk() {",
      "\t\tprintln(\"Hello, I am talking!\")",
      "\t}",
      "}"
    ],
    "description": "Declare a class with a struct constructor and methods"
  },
  "CIT Input": {
    "prefix": "input",
    "body": [
      "let ${1:name} = input(\"${2:What is your name? }\")",
      "println($\"Hello, {${1:name}}!\")"
    ],
    "description": "Prompt for user input and use a template string"
  },
  "CIT Error": {
    "prefix": "errorln",
    "body": [
      "errorln(\"${1:Something went wrong}\")"
    ],
    "description": "Print an error message"
  },
  "CIT Warning": {
    "prefix": "warnln",
    "body": [
      "warnln(\"${1:Be careful}\")"
    ],
    "description": "Print a warning message"
  },
  "CIT Import": {
    "prefix": "import",
    "body": [
      "import \"${1:package}\""
    ],
    "description": "Import an ipcit package or a .cit file"
  },
  "CIT Import As": {
    "prefix": "importas",
    "body": [
      "import \"${1:package}\" as ${2:alias}"
    ],
    "description": "Import a package under another name"
  },
  "CIT Do While": {
    "prefix": "dowhile",
    "body": [
      "do {",
      "\t$0",
      "} while (${1:condition})"
    ],
    "description": "do-while loop"
  },
  "CIT Empty Variable": {
    "prefix": "letempty",
    "body": [
      "let mut ${1:name}"
    ],
    "description": "Empty variable (must be mut)"
  },
  "CIT Multiple Variables": {
    "prefix": "letmulti",
    "body": [
      "let ${1:a}, ${2:b} = ${3:1}, ${4:2}"
    ],
    "description": "Declare several variables at once"
  },
  "CIT List": {
    "prefix": "list",
    "body": [
      "let mut ${1:nums} = [${2:1, 2, 3}]"
    ],
    "description": "List variable"
  },
  "CIT Range": {
    "prefix": "rangef",
    "body": [
      "range(${1:0}, ${2:10})"
    ],
    "description": "range() list"
  },
  "CIT For In": {
    "prefix": "forin",
    "body": [
      "for (let ${1:item} in ${2:items}) {",
      "\t$0",
      "}"
    ],
    "description": "for-in loop"
  },
  "CIT Dictionary": {
    "prefix": "dict",
    "body": [
      "let mut ${1:info} = {${2:name}: ${3:\"Coder\"}, ${4:age}: ${5:24}}"
    ],
    "description": "Dictionary"
  },
  "CIT Lambda": {
    "prefix": "lambda",
    "body": [
      "${1:x} => ${2:x * x}"
    ],
    "description": "Lambda (arrow function)"
  },
  "CIT Function Expression": {
    "prefix": "fnexpr",
    "body": [
      "let ${1:name} = fn ${1:name}(${2:x}) {",
      "\treturn $0",
      "}"
    ],
    "description": "Function stored in a variable"
  },
  "CIT Switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "\tcase ${2:\"a\"} {",
      "\t\t$0",
      "\t}",
      "\tcase default {",
      "\t\t",
      "\t}",
      "}"
    ],
    "description": "switch / case"
  },
  "CIT Class Inherit": {
    "prefix": "classinherit",
    "body": [
      "class ${1:child}(${2:parent}()) {",
      "\tfn struct(${3:args}) {",
      "\t\tsuper().struct(${4:args})",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Class that inherits from a parent class"
  },
  "CIT Safe Call": {
    "prefix": "safe",
    "body": [
      "${1:value}?.${2:method}()"
    ],
    "description": "Safe navigation (skips null)"
  },
  "CIT For Step": {
    "prefix": "forstep",
    "body": [
      "for (let mut ${1:i}, range(${2:0}, ${3:10}, ${4:2})) {",
      "\t$0",
      "}"
    ],
    "description": "for loop with a step"
  },
  "CIT Try Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (${2:err}) {",
      "\twarnln($\"${3:Found a bug}: {${2:err}}\")",
      "}"
    ],
    "description": "try / catch"
  },
  "CIT Throw": {
    "prefix": "throw",
    "body": [
      "throw ${1:\"message\"}"
    ],
    "description": "Raise an error"
  },
  "CIT Defer": {
    "prefix": "defer",
    "body": [
      "defer ${1:println(\"Prints last\")}"
    ],
    "description": "Run a statement when the function ends"
  },
  "CIT Multi-line String": {
    "prefix": "multiline",
    "body": [
      "let ${1:text} = \"\"\"",
      "${2:first line}",
      "${3:second line}",
      "\"\"\""
    ],
    "description": "Multi-line string"
  },
  "CIT In": {
    "prefix": "inop",
    "body": [
      "if (${1:\"x\"} in ${2:text}) {",
      "\t$0",
      "}"
    ],
    "description": "in operator"
  },
  "CIT Cast Fallback": {
    "prefix": "castfallback",
    "body": [
      "castInt(${1:input(\"Number: \")}, fallback = ${2:0})"
    ],
    "description": "Convert with a fallback value"
  },
  "CIT Random": {
    "prefix": "randint",
    "body": [
      "randint(${1:1}, ${2:100})"
    ],
    "description": "Random integer (inclusive)"
  },
  "CIT Temporal Variable": {
    "prefix": "temporal",
    "body": [
      "let mut ${1:name} <${2:2}${3|s,l|}> = ${4:value}"
    ],
    "description": "Declare a variable that expires after seconds (s) or source lines (l)"
  },
  "CIT Set": {
    "prefix": "setliteral",
    "body": [
      "let mut ${1:values} = {${2:1, 2, 3}}"
    ],
    "description": "Create a set of unique values"
  },
  "CIT Tuple": {
    "prefix": "tupleliteral",
    "body": [
      "let ${1:values} = (${2:1}, ${3:2})"
    ],
    "description": "Create an immutable tuple"
  },
  "CIT Discard Loop Value": {
    "prefix": "forignore",
    "body": [
      "for (_, range(${1:0}, ${2:12})) {",
      "\t${0:println(\"Hello\")}",
      "}"
    ],
    "description": "Loop without binding the range value"
  },
  "CIT Conditional Expression": {
    "prefix": "ternary",
    "body": [
      "${1:\"Even\"} if (${2:condition}) else ${3:\"Odd\"}"
    ],
    "description": "Choose a value with an inline if/else expression"
  },
  "CIT Math Import": {
    "prefix": "math",
    "body": [
      "import math",
      "math.${1|sqrt,ceil,floor,log,sin,cos|}(${2:value})"
    ],
    "description": "Import and use the built-in math module"
  },
  "CIT UI App": {
    "prefix": "uiapp",
    "body": [
      "import ui",
      "",
      "fn app(ui.title = \"${1:My App}\") {",
      "\treturn [",
      "\t\tui.h1(\"${2:Hello World!}\"),",
      "\t\tui.p(\"${3:Paragraph text}\")",
      "\t]",
      "}",
      "",
      "app().render()"
    ],
    "description": "Render a basic HTML-style UI in a VS Code webview"
  },
  "CIT File Write": {
    "prefix": "filewrite",
    "body": [
      "with open(\"${1:notes.txt}\", \"${2|write,append|}\", encoding = \"utf-8\") as file {",
      "\tfile.write(\"${3:Text}\\n\")",
      "}"
    ],
    "description": "Write or append UTF-8 text to a file"
  },
  "CIT Enum": {
    "prefix": "enum",
    "body": [
      "let enum ${1:colors} = ([",
      "\t\"${2:red}\",",
      "\t\"${3:blue}\"",
      "])"
    ],
    "description": "Declare named enum values"
  },
  "CIT Decorator": {
    "prefix": "decorator",
    "body": [
      "let ${1:logger} = fn ${1:logger}(original_func) {",
      "\treturn args => {",
      "\t\tprintln(\"Before the function starts...\")",
      "\t\tlet result = original_func(args)",
      "\t\tprintln(\"After the function starts...\")",
      "\t\treturn result",
      "\t}",
      "}",
      "",
      "@${1:logger}",
      "fn ${2:say_hello}(name) {",
      "\tprintln($\"Hello, {name}!\")",
      "}"
    ],
    "description": "Wrap a function with a decorator"
  },
  "CIT Multiple Import": {
    "prefix": "importmany",
    "body": [
      "import {",
      "\t${1:package1},",
      "\t${2:package2}",
      "}"
    ],
    "description": "Import several modules by name"
  },
  "CIT Shared Value Variables": {
    "prefix": "letall",
    "body": [
      "let mut ${1:first}, ${2:second}, ${3:third} = ${4:value}"
    ],
    "description": "Initialize several variables with one shared value"
  },
  "CIT Raise Error": {
    "prefix": "raise",
    "body": [
      "raise ${1|ValueError,TypeError,IndexError|}(\"${2:Invalid value}\")"
    ],
    "description": "Raise a typed error for an except clause"
  },
  "CIT Exchange": {
    "prefix": "exchange",
    "body": [
      "let ${1:oldValue} = exchange(${2:mutableVariable}, ${3:newValue})"
    ],
    "description": "Replace a mutable variable and keep its former value"
  },
  "CIT Wait": {
    "prefix": "taskwait",
    "body": [
      "task.wait(${1:2})"
    ],
    "description": "Pause a program for a number of seconds"
  },
  "CIT Read-limited Variable": {
    "prefix": "temporalread",
    "body": [
      "let mut ${1:name} <${2:5}r> = ${3:value}"
    ],
    "description": "Expire a variable after a number of reads"
  },
  "CIT Offline Variable": {
    "prefix": "temporaloffline",
    "body": [
      "let mut ${1:name} <${2:5}s = offline> = ${3:value}"
    ],
    "description": "Expire a variable after a period without reads"
  },
  "CIT Inactive Variable": {
    "prefix": "temporalstopuse",
    "body": [
      "let mut ${1:name} <${2:5}s = stopUse> = ${3:value}"
    ],
    "description": "Expire a variable after VS Code is inactive"
  },
  "CIT Guard": {
    "prefix": "guard",
    "body": [
      "guard (${1:condition}) else {",
      "\t${2:return null}",
      "}"
    ],
    "description": "Exit early unless a condition is true"
  },
  "CIT For Else": {
    "prefix": "forelse",
    "body": [
      "for (let ${1:item} in ${2:items}) {",
      "\tif (${3:condition}) {",
      "\t\tbreak",
      "\t}",
      "} else {",
      "\t${0:println(\"No matching item\")}",
      "}"
    ],
    "description": "Run the else block if the loop completes without break"
  },
  "CIT Property Accessors": {
    "prefix": "accessors",
    "body": [
      "get fn ${1:value}() {",
      "\treturn self.${1:value}",
      "}",
      "",
      "set fn ${1:value}(value) {",
      "\tself.${1:value} = value",
      "}"
    ],
    "description": "Define a class property getter and setter"
  },
  "CIT From Import": {
    "prefix": "fromimport",
    "body": [
      "import ${1:pi} from ${2:math}"
    ],
    "description": "Import a named value from a module"
  },
  "CIT JSON Import": {
    "prefix": "json",
    "body": [
      "import json",
      "let ${1:text} = json.dumps(${2:value}, indent = 2, sortKeys = true)",
      "let ${3:copy} = json.loads(${1:text})"
    ],
    "description": "Serialize and parse JSON data"
  },
  "CIT Time Import": {
    "prefix": "time",
    "body": [
      "import time",
      "println(time.strftime(\"${1:%Y-%m-%d %H:%M:%S}\", time.localtime()))"
    ],
    "description": "Use the built-in time module"
  },
  "CIT Fixed Width Variable": {
    "prefix": "fixedwidth",
    "body": [
      "int ${1:name}: i32 = ${2:0}"
    ],
    "description": "Declare an integer with a fixed-width storage constraint"
  },
  "CIT UI Style": {
    "prefix": "uistyle",
    "body": [
      "import ui-style",
      "",
      "fn ${1:myStyle}(style.title = \"${2:My Style}\") {",
      "\treturn [",
      "\t\tbody {",
      "\t\t\tbackgroundColor = \"${3:#ffffff}\"",
      "\t\t\ttextColor = \"${4:#222222}\"",
      "\t\t}",
      "\t]",
      "}"
    ],
    "description": "Define a CSS-like style for a UI webview"
  }
}
