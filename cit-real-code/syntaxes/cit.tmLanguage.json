{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CIT",
  "scopeName": "source.cit",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#templateStrings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#caseDefault"
    },
    {
      "include": "#classNames"
    },
    {
      "include": "#functionDeclarations"
    },
    {
      "include": "#functionKeyword"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#listMethods"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#self"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign",
          "begin": "#",
          "end": "$"
        },
        {
          "name": "comment.block",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    "templateStrings": {
      "name": "string.quoted.double",
      "begin": "\\$\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end"
            }
          },
          "patterns": [
            {
              "include": "#constants"
            },
            {
              "include": "#builtins"
            },
            {
              "include": "#listMethods"
            },
            {
              "include": "#self"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(let)\\s+(mut)\\b",
          "captures": {
            "1": {
              "name": "storage.type"
            },
            "2": {
              "name": "storage.modifier"
            }
          }
        },
        {
          "name": "storage.type",
          "match": "\\b(let|class)\\b"
        }
      ]
    },
    "functionDeclarations": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type"
        },
        "2": {
          "name": "entity.name.function"
        }
      }
    },
    "classNames": {
      "name": "entity.name.type",
      "match": "(?<=\\bclass\\s)[A-Za-z_][A-Za-z0-9_]*"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(if|elseif|else|while|do|switch|case|in|for|range|return|break|continue|pass|import|as)\\b"
        },
        {
          "name": "keyword.operator.logical",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language",
      "match": "\\b(true|false|null)\\b"
    },
    "builtins": {
      "name": "support.function",
      "match": "\\b(println|errorln|warnln|input|castInt|castFloat|castString|castBool|range|min|max|sum|len)\\b(?=\\s*\\()"
    },
    "self": {
      "name": "variable.language",
      "match": "\\b(self|super)\\b"
    },
    "types": {
      "name": "storage.type",
      "match": "\\b(int|float|str|char|bool)\\b(?=\\s+[A-Za-z_])"
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.type.function.arrow",
          "match": "=>"
        },
        {
          "name": "punctuation.accessor.optional",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.assignment.compound",
          "match": "\\*\\*=|//=|[+\\-*/%]="
        },
        {
          "name": "keyword.operator.increment",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.decrement",
          "match": "--"
        },
        {
          "name": "keyword.operator.comparison",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic",
          "match": "\\*\\*|//|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment",
          "match": "="
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "listMethods": {
      "name": "support.function",
      "match": "(?<=\\.)(append|pop|insert|clear|remove|reverse|count|index|copy|splice|unshift|shift|map|filter|reduce|slice|include|find|get|keys|values|update|items|popitem|default|fromkeys|ends|starts|substring|split|lower|upper|trim|replaceAll|replace|startPad|endPad|repeat|at|charAt|charCodeAt|indexOf)\\b(?=\\s*\\()"
    },
    "caseDefault": {
      "match": "\\b(case)\\s+(default)\\b",
      "captures": {
        "1": {
          "name": "keyword.control"
        },
        "2": {
          "name": "keyword.control"
        }
      }
    },
    "functionKeyword": {
      "name": "storage.type",
      "match": "\\bfn\\b"
    }
  }
}
