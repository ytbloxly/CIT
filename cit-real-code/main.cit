let mut newTuple = tuple(1, 2)
let mut newSet = set(1, 2)
let mut newDict = dict(num1: 1, num2: 2)
let mut newDict2 = frozendict(num1: 2, num2: 3)

# Ternary

let num = 2
println("Even" if (num % 2 == 0) else "Odd")