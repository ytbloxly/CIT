void main()
    default num gradePercent = 100;
    when (gradePercent) do
        default string grade = "Unknown";
        (gradePercent <= 100 && gradePercent > 90) is grade = "A";
        (gradePercent <= 89 && gradePercent > 65) is grade = "B";
        (gradePercent <= 64) is grade = "Fail";
    end;

    console.write(f"My grade is {grade.value}");
end;

return error.NoErr;
