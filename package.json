{
  "name": "cit-language",
  "displayName": "CIT (Code Information Technology)",
  "description": "CIT language: syntax colors, checks, auto-closing end;, terminal runner and UI preview for .cit files",
  "version": "0.5.0",
  "publisher": "cit",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "cit",
        "aliases": [
          "CIT",
          "cit"
        ],
        "extensions": [
          ".cit"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "cit",
        "scopeName": "source.cit",
        "path": "./syntaxes/cit.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cit",
        "path": "./snippets/cit.json"
      }
    ],
    "commands": [
      {
        "command": "cit.run",
        "title": "CIT: Run Code",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "cit.run",
          "when": "resourceLangId == cit",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "cit.run",
          "when": "resourceLangId == cit",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cit.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == cit"
      }
    ],
    "configuration": {
      "title": "CIT",
      "properties": {
        "cit.autoCloseEnd": {
          "type": "boolean",
          "default": true,
          "description": "Automatically insert `end;` when pressing Enter after `void main()`, `if ... do`, `for ... do` or `func ... do`."
        }
      }
    }
  }
}
