import ui;
import ui-style;

ui.root main(name="Body", title="My App" style-connect="styler()")
    ui my_button -> ui.button(id="Click", class="button") = "Click me!";
    ui note -> ui.h2() = "Styled with ui.style";
end;

ui.style styler()
    id.Click {
        background-color = color("blue");
        text-color = hsl(0, 0, 100);
        border = px(2), solid, rgb(255, 255, 255);
        font-size = px(18);
        font-family = "Arial", sans-serif;
        width = px(200);
        height = px(48);
    };
    name.note { text-color = hex("ff8800"); };
    class.button {};
    ui.button {};
    ui.button, ui.h2 {};
    uni {};
    # selectors: id.X  name.X  class.X  ui.<element>  uni (everything)
end;

void main()
    console.write("styled!");
end;

return error.NoErr;
