void main()
    default list array = [1, True, Null, "Hi!"];
    array.push("World");   # [1, True, Null, "Hi!", "World"]
    array.pop();           # [1, True, Null, "Hi!"]
    array.unshift(2);      # [2, 1, True, Null, "Hi!"]
    array.shift();         # [1, True, Null, "Hi!"]
    array.splice(5, 0, "!!");
    console.write(array);  # [1, True, Null, "Hi!", "!!"]
end;

return error.NoErr;
