import ui;
import ui-style;

ui.root main(name="Body", title="My App" style-connect="styler()")
    ui my_button -> ui.button(id="Click", class="button") = "Click me!";
    ui output -> ui.codeOutput() = "Output";
end;

ui.style styler()
    id.Click {
        background-color = color("yellow");
        text-color = color("black");
        border = px(2), solid, color("black");
    };

    id.Click.hover() { background-color = color("orange"); };                      # mouse is over it
    id.Click.hoverEnd() { background-color = color("lightyellow"); };              # mouse left it
    id.Click.active() { background-color = color("red"); transform = scale(0.95); }; # mouse button is down
    id.Click.clicked() { border-color = color("green"); };                        # it was clicked
end;

void main()
    my_button.hover(func hovering()
        console.write("hover");
    end);

    my_button.hoverEnd(func leaving()
        console.write("hoverEnd");
    end);

    my_button.active(func pressing()
        console.write("active");
    end);
end;

return error.NoErr;
