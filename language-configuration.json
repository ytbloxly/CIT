{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:void\\s+main\\s*\\(\\s*\\)|ui\\.root\\s+\\w+\\s*\\(.*\\)|(?:if|for|func|else|while|class|task|when|raise)\\b.*\\bdo|(?:default|global|const)\\s+enum\\b.*\\bdo|.*\\(\\s*func\\s+\\w+\\s*\\([^)]*\\))\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:end\\s*\\)?\\s*;|else\\b.*\\bdo)\\s*(?:#.*)?$"
  }
}
