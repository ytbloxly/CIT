import ui;

ui.root main(name="Body", title="Button Clicker")
    ui passwords -> ui.input(type="password", minLength=2, maxLength=16) = "Placeholder";
    ui text_inp -> ui.input(type="text") = "Placeholder";
    ui email_inp -> ui.input(type="email" required) = "Placeholder";
    ui output -> ui.codeOutput() = "Output";
end;

void main()
    email_inp && text_inp && passwords.focus(func focusing()
        console.write("You are focusing on inputs");
    end);

    email_inp && text_inp && passwords.focusEnd(func unfocusing()
        console.write("You stopped focusing");
    end);

    email_inp && text_inp && passwords.typed(func typing()
        console.write("You are typing");
    end);

    email_inp.typed(func checking()
        console.write(f"email valid: {email_inp.valid}");
    end);
end;

return error.NoErr;
