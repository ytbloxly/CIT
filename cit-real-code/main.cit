# Temporal variables

let mut num <2s> = 2 # This variable is going to be for 2 seconds after the start of the program
let mut num2 <30l> = 3 # This variable is going to be to after 30 lines of code (4-34)

# Getting multiple variables one value

let mut a, b, c = 2 # a and b and c is 2

