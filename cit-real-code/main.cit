# It just doesnt stores for loop in any variable

# Encapsulation

class person() {
	fn struct(bank, pin, balance) {
		self.bank = bank
        protected self.pin = pin
        private self.balance = balance
	}

    fn showCreditCardInfo() {
		println(bank, pin, balance)
	}
}

let mut p = person("Chase", 1234, 12.34)
println(p)

# Polymorphism

class Animal() {
    fn struct(name) {
        self.name = name
    }

    fn make_sound() {
        println($"{self.name} makes a generic sound.")
    }
}

class Dog(Animal()) {
    fn struct(name) {
        super().struct(name)
    }

    fn make_sound() {
        println($"{self.name} barks: Woof!")
    }
}

class Cat(Animal()) {
    fn struct(name) {
        super().struct(name)
    }

    fn make_sound() {
        println($"{self.name} meows: Meow!")
    }
}

fn introduce_animal(animal) {
    animal.make_sound()
}

# Użycie w praktyce
let mut d = Dog("Rex")
let mut c = Cat("Whiskers")

introduce_animal(d)
introduce_animal(c)

