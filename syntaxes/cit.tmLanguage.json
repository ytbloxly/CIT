{
  "name": "CIT",
  "scopeName": "source.cit",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#fstring"
    },
    {
      "include": "#string"
    },
    {
      "include": "#main"
    },
    {
      "include": "#classdef"
    },
    {
      "include": "#taskdef"
    },
    {
      "include": "#funcdef"
    },
    {
      "include": "#importkw"
    },
    {
      "include": "#mathns"
    },
    {
      "include": "#uins"
    },
    {
      "include": "#task"
    },
    {
      "include": "#rangekw"
    },
    {
      "include": "#statekw"
    },
    {
      "include": "#selector"
    },
    {
      "include": "#uni"
    },
    {
      "include": "#styleprop"
    },
    {
      "include": "#attrflag"
    },
    {
      "include": "#attrname"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#cssvalue"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#types"
    },
    {
      "include": "#optional"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#console"
    },
    {
      "include": "#casts"
    },
    {
      "include": "#thisvar"
    },
    {
      "include": "#property"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#step"
    },
    {
      "include": "#arrow"
    },
    {
      "include": "#pairarrow"
    },
    {
      "include": "#comparison"
    },
    {
      "include": "#logical"
    },
    {
      "include": "#bitops"
    },
    {
      "include": "#assign"
    },
    {
      "include": "#arith"
    },
    {
      "include": "#terminator"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.cit",
      "match": "#.*$"
    },
    "main": {
      "match": "\\b(void)\\s+(main)\\b",
      "captures": {
        "1": {
          "name": "storage.type.function.cit"
        },
        "2": {
          "name": "entity.name.function.cit"
        }
      }
    },
    "classdef": {
      "match": "\\b(class)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "storage.type.class.cit"
        },
        "2": {
          "name": "entity.name.type.class.cit"
        }
      }
    },
    "funcdef": {
      "match": "\\b(func)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "storage.type.function.cit"
        },
        "2": {
          "name": "entity.name.function.cit"
        }
      }
    },
    "importkw": {
      "match": "\\b(import)\\s+([A-Za-z_][\\w-]*)",
      "captures": {
        "1": {
          "name": "keyword.control.import.cit"
        },
        "2": {
          "name": "entity.name.namespace.cit"
        }
      }
    },
    "uins": {
      "match": "\\b(ui)(\\.)(root|style|button|p|h1|h2|h3|input|codeOutput)\\b",
      "captures": {
        "1": {
          "name": "support.class.cit"
        },
        "2": {
          "name": "punctuation.accessor.cit"
        },
        "3": {
          "name": "support.function.cit"
        }
      }
    },
    "task": {
      "match": "\\b(task)(\\.)(wait|start|repeat|stop|repeated)\\b",
      "captures": {
        "1": {
          "name": "support.class.cit"
        },
        "2": {
          "name": "punctuation.accessor.cit"
        },
        "3": {
          "name": "support.function.cit"
        }
      }
    },
    "rangekw": {
      "name": "keyword.other.range.cit",
      "match": "\\brange\\b(?=\\s*=)"
    },
    "attrname": {
      "name": "entity.other.attribute-name.cit",
      "match": "\\b(id|class|name|title|style-connect|type|minLength|maxLength)\\b(?=\\s*=\\s*[\\\"\\d])"
    },
    "keywords": {
      "name": "keyword.control.cit",
      "match": "\\b(if|else|for|while|do|end|return|class|break|continue|pass|when|is|raise|until|switch|case|try|catch|except|finally|as)\\b"
    },
    "modifiers": {
      "name": "storage.modifier.cit",
      "match": "\\b(default|global|const)\\b"
    },
    "types": {
      "name": "storage.type.cit",
      "match": "\\b(num|bool|string|input|classIns|list|enum|ui)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cit",
          "match": "\\b(True|False|Null)\\b"
        },
        {
          "name": "constant.language.error.cit",
          "match": "\\berror\\.[A-Za-z_]\\w*"
        }
      ]
    },
    "console": {
      "match": "\\b(console)(\\.)(write|input)\\b",
      "captures": {
        "1": {
          "name": "support.class.cit"
        },
        "2": {
          "name": "punctuation.accessor.cit"
        },
        "3": {
          "name": "support.function.cit"
        }
      }
    },
    "casts": {
      "name": "support.function.cast.cit",
      "match": "\\b(parseInt|parseFloat|parseString|parseBool|type|isinstance|issubclass|len|list|set|tuple|max|min)\\b(?=\\s*\\()"
    },
    "thisvar": {
      "name": "variable.language.this.cit",
      "match": "\\b(this|super)\\b"
    },
    "property": {
      "match": "\\b([A-Za-z_]\\w*)(\\.)(value|name)\\b",
      "captures": {
        "1": {
          "name": "variable.other.cit"
        },
        "2": {
          "name": "punctuation.accessor.cit"
        },
        "3": {
          "name": "support.variable.property.cit"
        }
      }
    },
    "numbers": {
      "name": "constant.numeric.cit",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "arrow": {
      "name": "keyword.operator.arrow.cit",
      "match": "(->|>>)"
    },
    "comparison": {
      "name": "keyword.operator.comparison.cit",
      "match": "(==|!=|<=|>=|<|>)"
    },
    "logical": {
      "name": "keyword.operator.logical.cit",
      "match": "(&&|\\|\\||!)"
    },
    "assign": {
      "name": "keyword.operator.assignment.cit",
      "match": "(\\+=|-=|\\*=|/=|%=|=)"
    },
    "arith": {
      "name": "keyword.operator.arithmetic.cit",
      "match": "[+\\-*/%]"
    },
    "terminator": {
      "name": "punctuation.terminator.statement.cit",
      "match": ";"
    },
    "call": {
      "name": "entity.name.function.call.cit",
      "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"
    },
    "member": {
      "name": "variable.other.property.cit",
      "match": "(?<=\\.)[A-Za-z_]\\w*"
    },
    "ident": {
      "name": "variable.other.cit",
      "match": "\\b[A-Za-z_]\\w*\\b"
    },
    "escapes": {
      "name": "constant.character.escape.cit",
      "match": "\\\\."
    },
    "string": {
      "name": "string.quoted.double.cit",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "name": "meta.interpolation.cit",
          "begin": "\\$\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.begin.cit"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.end.cit"
            }
          },
          "patterns": [
            {
              "include": "#bitops"
            },
            {
              "include": "#mathns"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#casts"
            },
            {
              "include": "#thisvar"
            },
            {
              "include": "#property"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#comparison"
            },
            {
              "include": "#logical"
            },
            {
              "include": "#arith"
            },
            {
              "include": "#member"
            },
            {
              "include": "#ident"
            }
          ]
        }
      ]
    },
    "fstring": {
      "name": "string.quoted.double.fstring.cit",
      "begin": "\\b(f)(\\\")",
      "end": "\"",
      "beginCaptures": {
        "1": {
          "name": "storage.type.string.prefix.cit"
        },
        "2": {
          "name": "string.quoted.double.cit"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "name": "meta.interpolation.cit",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.begin.cit"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.end.cit"
            }
          },
          "patterns": [
            {
              "include": "#bitops"
            },
            {
              "include": "#mathns"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#casts"
            },
            {
              "include": "#thisvar"
            },
            {
              "include": "#property"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#comparison"
            },
            {
              "include": "#logical"
            },
            {
              "include": "#arith"
            },
            {
              "include": "#member"
            },
            {
              "include": "#ident"
            }
          ]
        }
      ]
    },
    "taskdef": {
      "match": "\\b(task)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "storage.type.function.cit"
        },
        "2": {
          "name": "entity.name.function.cit"
        }
      }
    },
    "step": {
      "name": "keyword.operator.increment.cit",
      "match": "(\\+\\+|--)"
    },
    "selector": {
      "match": "\\b(id|name|class)(\\.)([A-Za-z_][\\w-]*)",
      "captures": {
        "1": {
          "name": "entity.name.tag.cit"
        },
        "2": {
          "name": "punctuation.accessor.cit"
        },
        "3": {
          "name": "entity.other.attribute-name.class.cit"
        }
      }
    },
    "uni": {
      "name": "entity.name.tag.universal.cit",
      "match": "\\buni\\b(?=\\s*[,{])"
    },
    "styleprop": {
      "name": "support.type.property-name.cit",
      "match": "\\b(background-color|text-color|border-color|border-type|border-size|border-corner|border|font-size|font-family|width|height|display|margin|padding|position|transform)\\b(?=\\s*=)"
    },
    "cssvalue": {
      "name": "support.constant.property-value.cit",
      "match": "\\b(solid|dashed|double|groove|dotted|ridge|inset|outset|hidden|serif|sans-serif|monospace|cursive|fantasy|system-ui|inline-block|inline|grid|flexbox|flex|block|static|relative|sticky|absolute|fixed|translate|scale|rotate|skew)\\b"
    },
    "attrflag": {
      "name": "entity.other.attribute-name.cit",
      "match": "\\brequired\\b(?=\\s*\\))"
    },
    "mathns": {
      "match": "\\b(math)(\\.)(pi|e|tau|ceiling|floor|trunc|sqrt|cbrt|power|log10|log|sin|cos|tan|degrees|radians|factorial|gcd|fabs)\\b",
      "captures": {
        "1": {
          "name": "support.class.cit"
        },
        "2": {
          "name": "punctuation.accessor.cit"
        },
        "3": {
          "name": "support.function.cit"
        }
      }
    },
    "optional": {
      "name": "storage.type.cit",
      "match": "(?<=\\bdefault\\s|\\bglobal\\s|\\bconst\\s)\\?"
    },
    "statekw": {
      "match": "(\\.)(clicked|hover|hoverEnd|active)(?=\\(\\)\\s*(?:\\{|,))",
      "captures": {
        "1": {
          "name": "punctuation.accessor.cit"
        },
        "2": {
          "name": "entity.other.pseudo-class.cit"
        }
      }
    },
    "pairarrow": {
      "name": "keyword.operator.arrow.cit",
      "match": "=>"
    },
    "bitops": {
      "name": "keyword.operator.set.cit",
      "match": "(?<![|&])[|&^](?![|&])"
    }
  }
}
