# As a statement, a string method changes the variable. Inside an expression it just gives a new string.
void main()
    default string str = "BsHHaIIlK";
    str.toUpperCase();
    console.write(str);                   # BSHHAIILK
    str.toLowerCase();
    console.write(str);                   # bshhaiilk
    str.replace("bs" => "sb");            # => means "with"
    console.write(str);                   # sbhhaiilk
    console.write(str.includes("hha"));   # True
    console.write(str.startsWith("sbh")); # True
    console.write(str.endsWith("lki"));   # False
    console.write(str.substring(3, 9));   # haiilk   (str itself is not changed here)
    str.substring(3, 9);
    console.write(str);                   # haiilk
end;

return error.NoErr;
