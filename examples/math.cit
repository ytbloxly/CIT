import math as m;

void main()
    default num PI = m.pi;     # math.pi also works
    default num E = math.e;
    default num Tau = m.tau;
    console.write(PI);
    console.write(math.ceiling(4.2));
    console.write(math.floor(4.8));
    console.write(math.trunc(-4.8));
    console.write(math.sqrt(16));
    console.write(math.cbrt(27));
    console.write(math.power(2, 10));
    console.write(math.log(8, 2));
    console.write(math.log10(1000));
    console.write(math.degrees(PI));
    console.write(math.factorial(5));
    console.write(math.gcd(12, 18));
    console.write(math.fabs(-3.5));
end;

return error.NoErr;
