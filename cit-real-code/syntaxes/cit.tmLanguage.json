{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CIT",
  "scopeName": "source.cit",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#tripleTemplateStrings"
    },
    {
      "include": "#tripleStrings"
    },
    {
      "include": "#templateStrings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#temporal"
    },
    {
      "include": "#caseDefault"
    },
    {
      "include": "#classNames"
    },
    {
      "include": "#functionDeclarations"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#functionKeyword"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#listMethods"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#self"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign",
          "begin": "#",
          "end": "$"
        },
        {
          "name": "comment.block",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    "templateStrings": {
      "name": "string.quoted.double",
      "begin": "\\$\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end"
            }
          },
          "patterns": [
            {
              "include": "#constants"
            },
            {
              "include": "#builtins"
            },
            {
              "include": "#listMethods"
            },
            {
              "include": "#self"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(let)\\s+(mut)\\b",
          "captures": {
            "1": {
              "name": "storage.type"
            },
            "2": {
              "name": "storage.modifier"
            }
          }
        },
        {
          "name": "storage.type",
          "match": "\\b(let|class|const|static)\\b"
        }
      ]
    },
    "temporal": {
      "name": "storage.modifier.temporal",
      "match": "<\\s*[0-9]+\\s*[slr](?:\\s*=\\s*(?:offline|stopUse))?\\s*>"
    },
    "functionDeclarations": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type"
        },
        "decorators": {
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation"
            },
            "2": {
              "name": "entity.name.function"
            }
          }
        },
        "2": {
          "name": "entity.name.function"
        }
      }
    },
    "classNames": {
      "name": "entity.name.type",
      "match": "(?<=\\bclass\\s)[A-Za-z_][A-Za-z0-9_]*"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(if|elseif|else|while|do|switch|case|in|try|catch|except|finally|throw|raise|defer|for|range|return|break|continue|pass|import|as|with|enum|private|protected|public|final|get|set|guard)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language",
      "match": "\\b(true|false|null)\\b"
    },
    "builtins": {
      "name": "support.function",
      "match": "\\b(println|printf|errorln|warnln|input|castInt|castFloat|castString|castBool|range|min|max|sum|len|random|randint|list|tuple|set|dict|frozendict|frozenset|object|bin|zip|enumerate|enumarate|round|id|type|isinstance|issubclass|square|exchange|open|sleep|union|intersection|difference|symmetricDifference|longString|longNumber|hex|hsl|hsv|rgb|rgba|clr)\\b(?=\\s*\\()"
    },
    "self": {
      "name": "variable.language",
      "match": "\\b(self|super)\\b"
    },
    "types": {
      "name": "storage.type",
      "match": "\\b(int|float|str|char|bool|i8|i16|i32|i64|f8|f16|f32|f64|s8|s16|s32|s64|b8|b16)\\b(?=\\s+[A-Za-z_])"
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.type.function.arrow",
          "match": "=>"
        },
        {
          "name": "punctuation.accessor.optional",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.assignment.compound",
          "match": "\\*\\*=|//=|[+\\-*/%]="
        },
        {
          "name": "keyword.operator.increment",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.decrement",
          "match": "--"
        },
        {
          "name": "keyword.operator.comparison",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic",
          "match": "\\*\\*|//|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment",
          "match": "="
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "listMethods": {
      "name": "support.function",
      "match": "(?<=\\.)(append|pop|insert|clear|remove|reverse|count|index|copy|splice|unshift|shift|map|filter|reduce|slice|include|find|get|keys|values|update|items|popitem|default|fromkeys|ends|starts|substring|split|lower|upper|trim|replaceAll|replace|startPad|endPad|repeat|at|charAt|charCodeAt|indexOf|toFixed|ceil|floor|trunc|sqrt|cbrt|exp|log|log2|sin|cos|tan|degrees|radians|factorial|gcd|lcm|h1|h2|h3|h4|h5|h6|title|header|render|wait|write|read)\\b(?=\\s*\\()"
    },
    "caseDefault": {
      "match": "\\b(case)\\s+(default)\\b",
      "captures": {
        "1": {
          "name": "keyword.control"
        },
        "2": {
          "name": "keyword.control"
        }
      }
    },
    "functionKeyword": {
      "name": "storage.type",
      "match": "\\bfn\\b"
    },
    "tripleTemplateStrings": {
      "name": "string.quoted.triple",
      "begin": "\\$\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end"
            }
          },
          "patterns": [
            {
              "include": "#constants"
            },
            {
              "include": "#builtins"
            },
            {
              "include": "#listMethods"
            },
            {
              "include": "#self"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "tripleStrings": {
      "name": "string.quoted.triple",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    }
  }
}
