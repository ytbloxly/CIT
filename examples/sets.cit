void main()
    default list set1 = {1, 2, 2, 3, 1, 4, 5, 2, 3};
    console.write(set1);          # {1, 2, 3, 4, 5}

    set1.add(6);
    set1.discard(1);
    set1.remove(3);
    console.write(set1.has(2));   # True
    console.write(set1);          # {2, 4, 5, 6}
    set1.clear();
    console.write(set1);          # set()

    default list setToMerge = {1, 4, 5, 2, 1, 2};
    default list setToMerge2 = {2, 3, 4, 3, 1, 2};
    console.write(setToMerge | setToMerge2);  # union:                {1, 4, 5, 2, 3}
    console.write(setToMerge & setToMerge2);  # intersection:         {1, 4, 2}
    console.write(setToMerge - setToMerge2);  # difference:           {5}
    console.write(setToMerge ^ setToMerge2);  # symmetric difference: {5, 3}
end;

return error.NoErr;
